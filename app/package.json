{
  "name": "formation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build --configLoader runner",
    "build:public": "tsc -b && vite build --configLoader runner --mode public && node scripts/audit-public-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/data.test.mjs tests/identity.test.mjs tests/forecast.test.mjs tests/prospective-score.test.mjs",
    "test:browser": "node tests/public-browser.mjs",
    "test:production": "node tests/populated-production.mjs",
    "format": "prettier --write src/*.{ts,tsx,css} tests/*.mjs scripts/*.mjs vite.config.ts"
  },
  "dependencies": {
    "gsap": "3.13.0",
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "0.176.0"
  },
  "devDependencies": {
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@types/three": "0.176.0",
    "@vitejs/plugin-react": "4.4.1",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vite": "6.4.3"
  }
}
